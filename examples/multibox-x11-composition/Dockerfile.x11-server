FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11-utils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create display directory for UNIX sockets
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Xvfb listens on display :0 (UNIX socket at /tmp/.X11-unix/X0)
# With -listen tcp, it also accepts TCP connections on port 6000
EXPOSE 6000

CMD ["Xvfb", ":0", "-screen", "0", "1024x768x24", "-listen", "tcp"]
